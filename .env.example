# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/phatphap
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=phatphap
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Application
APP_NAME="Phật Pháp"
APP_URL=http://localhost:3000

# AI - Google Gemini (lấy tại aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
